{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "haustmann",
  "compatibility_date": "2026-10-29",
  // site statique : pas de Worker, Cloudflare sert le dossier dist
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
