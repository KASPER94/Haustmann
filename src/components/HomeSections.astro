---
// Sections de l'accueil, sous le héros
import DeroulePlan from './DeroulePlan.astro';
import ParisPlan from './ParisPlan.astro';
// Calendrier synchronisé (illustration) : jours réservés sur 14 jours, par plateforme
const CAL: [string, number[]][] = [['Airbnb', [2, 3, 4, 9, 10]], ['Booking.com', [6, 7]], ['Vrbo', [12, 13]]];
const taken: Record<number, string> = {};
CAL.forEach(([name, days]) => days.forEach((d) => (taken[d] = name)));
// Téléphone : les six services en une phrase chacun, pour la carte tarif
const SM_LIST = [
  'Séance photo et annonce en français et en anglais',
  'Prix ajustés chaque jour sur Airbnb, Booking.com et Vrbo',
  'Voyageurs sélectionnés et accueillis, remise des clés',
  'Linge hôtelier changé à chaque séjour',
  'Assistance 7&nbsp;j/7, un seul interlocuteur',
  'Un relevé des revenus après chaque séjour',
];
// Le déroulé : une ligne par service. s relie la ligne à un calque du plan, cue est la fréquence affichée sous le plan
const DR = [
  { word: 'Avant,', title: "Nous préparons l'appartement", lines: [
    { s: 'visite', k: 'Visite', v: 'conseils de préparation', cue: 'Étape 1 sur 4' },
    { s: 'photos', k: 'Photos', v: 'séance professionnelle', cue: 'Étape 2 sur 4' },
    { s: 'annonce', k: 'Annonce', v: 'en français et en anglais', cue: 'Étape 3 sur 4' },
    { s: 'enligne', k: 'En ligne', v: 'Airbnb, Booking.com, Vrbo', cue: 'Étape 4 sur 4' },
  ] },
  { word: 'pendant,', title: 'Nous recevons vos voyageurs', lines: [
    { s: 'prix', k: 'Prix', v: 'ajustés chaque jour', cue: 'Chaque jour' },
    { s: 'voyageurs', k: 'Voyageurs', v: 'sélectionnés et accueillis', cue: 'À chaque réservation' },
    { s: 'cles', k: 'Clés', v: "remises à l'arrivée", cue: 'À chaque arrivée' },
    { s: 'menage', k: 'Ménage', v: 'linge hôtelier changé à chaque séjour', cue: 'À chaque séjour' },
    { s: 'assistance', k: 'Assistance', v: '7\u00a0j/7, un seul interlocuteur', cue: '7 jours sur 7' },
  ] },
  { word: 'après.', title: 'Vous retrouvez votre intérieur', lines: [
    { s: 'appartement', k: 'Appartement', v: 'nettoyé, linge changé', cue: 'À votre retour' },
    { s: 'affaires', k: 'Vos affaires', v: 'à leur place', cue: 'À votre retour' },
    { s: 'releve', k: 'Relevé', v: 'des séjours et des revenus', cue: 'À votre retour' },
  ] },
];
---
<div class="gutter">
  <div class="strip wrap" style="max-width:none">
    <div class="listing" data-reveal>
      <div class="ls-head"><p class="eyebrow">Votre annonce</p></div>
      <div class="ls-media" data-reveal-img>
        <div class="ls-track" id="ls-track" tabindex="0" role="group" aria-label="Photos de l'annonce, flèches gauche et droite pour défiler">
          <img src="/img/salon-blanc.webp" alt="Séjour blanc, moulures et parquet en point de Hongrie">
          <img src="/img/sejour-plantes.webp" alt="Table ronde et plantes, vue sur le séjour" loading="lazy">
          <img src="/img/chambre-fenetre.webp" alt="Chambre, porte-fenêtre et balcon en fer forgé" loading="lazy">
          <img src="/img/fauteuil-fenetre.webp" alt="Fauteuil près de la fenêtre" loading="lazy">
          <img src="/img/salle-a-manger.webp" alt="Salle à manger, mur bleu et fauteuil rose" loading="lazy">
        </div>
        <span class="ls-chip">Photos professionnelles</span>
        <button class="ls-nav prev" type="button" aria-label="Photo précédente"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9 2L4 7l5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
        <button class="ls-nav next" type="button" aria-label="Photo suivante"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M5 2l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
        <div class="ls-dots" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i><i></i></div>
        <span class="ls-count" id="ls-count" aria-hidden="true">1 / 5</span>
      </div>
      <div class="ls-body" id="ls-body" lang="fr">
        <div class="ls-title-row">
          <p class="ls-title" id="ls-title">Deux-pièces lumineux, moulures et balcon</p>
          <div class="lang" role="group" aria-label="Langue de l'annonce"><button type="button" data-lang="fr" aria-pressed="true">FR</button><button type="button" data-lang="en" aria-pressed="false">EN</button></div>
        </div>
        <p class="ls-meta" id="ls-meta">Paris 11e · 45&nbsp;m² · 2 voyageurs · 1 chambre</p>
        <p class="ls-desc" id="ls-desc">Parquet en point de Hongrie, moulures et grandes fenêtres. Quatrième étage avec ascenseur.</p>
      </div>
    </div>
    <div class="stats" id="offre-stats">
      <div class="stats-row">
        <div class="stat" data-reveal><span class="k"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5 11l6-6M5.5 5.5h.01M10.5 10.5h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Commission</span><div class="v">12<sup>%</sup></div><p>des loyers perçus, en gestion complète</p></div>
        <div class="stat" data-reveal><span class="k"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 9.5A5.5 5.5 0 1 1 6.5 3a4.5 4.5 0 0 0 6.5 6.5z" fill="currentColor"/></svg>Résidence principale</span><div class="v">90</div><p>nuits par an au maximum à Paris</p></div>
        <div class="stat" data-reveal><span class="k"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2 6.5h12M5 1.5v3M11 1.5v3" stroke="currentColor" stroke-width="1.4"/></svg>Plateformes</span><div class="v">3</div><p>annonces, un seul calendrier</p></div>
      </div>
      <div class="incl" data-reveal>
        <p class="k2">Compris dans les <b>12&nbsp;%</b></p>
        <dl class="incl-grid">
          <div><svg aria-hidden="true"><use href="#i-photo"/></svg><dt>Annonce et photos</dt><dd>Séance photo professionnelle, annonce en français et en anglais.</dd></div>
          <div><svg aria-hidden="true"><use href="#i-price"/></svg><dt>Prix ajustés chaque jour</dt><dd>Alignés sur Airbnb, Booking.com et Vrbo.</dd></div>
          <div><svg aria-hidden="true"><use href="#i-key"/></svg><dt>Accueil des voyageurs</dt><dd>Sélection des voyageurs, accueil et remise des clés.</dd></div>
          <div><svg aria-hidden="true"><use href="#i-linen"/></svg><dt>Ménage et linge</dt><dd>Linge hôtelier changé à chaque séjour. Le ménage est réglé par le voyageur.</dd></div>
          <div><svg aria-hidden="true"><use href="#i-help"/></svg><dt>Assistance 7&nbsp;j/7</dt><dd>Un interlocuteur unique, pour les voyageurs comme pour vous.</dd></div>
          <div><svg aria-hidden="true"><use href="#i-doc"/></svg><dt>Relevé des revenus</dt><dd>Un compte rendu après chaque séjour.</dd></div>
        </dl>
      </div>
      <div class="stats-foot">
        <div class="duo"><span class="pics"><img src="/img/studio-bleu.webp" alt=""><img src="/img/salon-blanc.webp" alt=""></span><span>Studios et appartements<br>du 1<sup>er</sup> au 20<sup>e</sup></span></div>
        <a class="more" href="#etapes">Tous les services de la conciergerie <svg aria-hidden="true"><use href="#arrow"/></svg></a>
      </div>
      <div class="stats-m" data-reveal>
        <div class="sm-top"><p class="k2">Gestion complète</p><p class="sm-price"><span class="num">12<sup>%</sup></span><span class="unit">des loyers perçus</span></p></div>
        <ul class="sm-list">
          {SM_LIST.map((s) => <li><span class="chk"><svg aria-hidden="true"><use href="#check"/></svg></span><span set:html={s}></span></li>)}
        </ul>
        <p class="sm-note">Sans frais d'entrée. Le ménage est réglé par le voyageur.</p>
        <button class="btn btn-terra" type="button" data-open-flow>Estimer mon appartement <svg aria-hidden="true"><use href="#arrow"/></svg></button>
      </div>
    </div>
  </div>
</div>

<section class="intro gutter" id="principe">
  <div class="wrap intro-grid">
    <div>
      <p class="eyebrow" data-reveal>Le principe</p>
      <h2 data-reveal>De l'annonce<br><span class="it">aux draps propres.</span></h2>
    </div>
    <p data-reveal>Annonce, voyageurs, ménage, linge&nbsp;: Haustmann gère la location courte durée de votre appartement parisien pendant vos absences, et vous le rend comme vous l'avez laissé.</p>
  </div>
</section>

<section class="gutter" id="offre" aria-label="L'offre">
  <div class="wrap bento">
    <div class="b-offer" data-reveal>
      <p class="eyebrow">L'offre</p>
      <p class="big" aria-label="12 pour cent">12<span>%</span></p>
      <p class="lead">des loyers perçus. Gestion complète, sans frais d'entrée, ménage réglé par le voyageur.</p>
      <div class="calc">
        <div class="full">
          <label for="calc-loyers">Loyers perçus sur l'année</label>
          <div class="v" id="calc-val">20 000 €</div>
          <input type="range" id="calc-loyers" min="2000" max="60000" step="500" value="20000">
        </div>
        <div><span class="k">Commission Haustmann</span><div class="v" id="calc-fee">2 400 €</div></div>
        <div><span class="k">Vous recevez</span><div class="v" id="calc-net">17 600 €</div></div>
        <p class="note full">Calcul indicatif. Base de calcul et TVA à préciser.</p>
      </div>
    </div>
    <div class="b-photos" id="b-photos">
      <div class="fan" id="fan">
        <img src="/img/salon-blanc.webp" alt="" style="--i:-1.5">
        <img src="/img/studio-bleu.webp" alt="" style="--i:-.5">
        <img src="/img/fauteuil-fenetre.webp" alt="" style="--i:.5">
        <img src="/img/entree-banquette.webp" alt="" style="--i:1.5">
      </div>
      <div><h3>Photos professionnelles incluses</h3><p>Un photographe passe avant la mise en ligne. Votre annonce est rédigée en français et en anglais.</p></div>
    </div>
    <div class="b-nights" data-reveal>
      <h3>Nous tenons le compte des nuits.</h3>
      <div class="num">90<small>nuits par an</small></div>
      <div class="meter">
        <div class="meter-head"><span>Compteur 2026 · résidence principale</span><b>54 / 90</b></div>
        <div class="bar" role="img" aria-label="54 nuits louées sur 90 autorisées"><i id="bar-fill"></i></div>
        <small>Nous fermons le calendrier avant le plafond, toutes plateformes confondues.</small>
      </div>
    </div>
    <div class="b-sync" data-reveal>
      <h3>Un seul calendrier.</h3>
      <div class="cal" id="cal" aria-hidden="true">{CAL.map(([name]) => (
          <div class="cal-row"><span>{name}</span><div class="cal-days">{Array.from({ length: 14 }, (_, d) => <i class={taken[d] === name ? 'on' : taken[d] ? 'off' : ''}></i>)}</div></div>
        ))}</div>
      <p>Une réservation prise sur une plateforme bloque les dates sur les deux autres. Pas de double réservation.</p>
    </div>
  </div>
</section>

<section class="steps gutter" id="etapes">
  <div class="wrap">
    <div class="steps-head">
      <h2 class="eyebrow" data-reveal>Le déroulé</h2>
      <p data-reveal>Un interlocuteur unique, des prestataires que nous choisissons, et un compte rendu après chaque séjour.</p>
    </div>
    <div class="dr" id="dr" data-on="visite" data-m="0">
      <div class="dr-stage" aria-hidden="true">
        <div class="dr-prog"><span data-i="0">Avant</span><span data-i="1">Pendant</span><span data-i="2">Après</span></div>
        <div class="dr-card">
          <p class="dr-head"><span>Votre appartement</span></p>
          <DeroulePlan />
          <div class="dr-foot">
            <p class="dr-cue it">{DR[0].lines[0].cue}</p>
            <div class="dr-chips">
              <span class="ov" data-s="enligne"><svg><use href="#i-globe"/></svg>Airbnb · Booking.com · Vrbo</span>
              <span class="ov" data-s="prix"><svg class="spark" viewBox="0 0 46 14"><polyline points="0,10 6,8 12,9 18,5 24,6 30,3 36,7 42,4 46,6" /></svg>Prix par nuit</span>
              <span class="ov" data-s="assistance"><svg><use href="#i-help"/></svg>Un seul interlocuteur</span>
              <span class="ov" data-s="appartement"><svg><use href="#check"/></svg>Comme vous l'avez laissé</span>
            </div>
          </div>
        </div>
      </div>
      <div class="dr-track">
        {DR.map((m, i) => (
          <div class="dr-mo">
            <h3><span class:list={['dr-word', { it: i === 2 }]}>{m.word}</span> {m.title}</h3>
            <ol class="dr-lines">
              {m.lines.map((l) => <li class="dr-ln" data-s={l.s} data-m={i} data-cue={l.cue}><b>{l.k}</b> <span>{l.v}</span></li>)}
            </ol>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="paris" id="paris" aria-label="Paris">
  <div class="gutter">
    <p class="pword" id="pword" aria-hidden="true">PARIS</p>
    <div class="wrap paris-foot" id="paris-plan">
      <div class="pf-copy">
        <p class="eyebrow">Paris</p>
        <h2>Arrondissement par arrondissement.</h2>
      </div>
      <div class="pm-clip"><ParisPlan /></div>
      <div class="pf-pick">
        <div class="pm-out">
          <p class="pm-hint">Choisissez le vôtre sur le plan pour commencer l'estimation.</p>
          <div class="pm-sel" hidden><b class="pm-n"></b><span class="pm-cp"></span><span class="pm-q"></span></div>
          <p class="sr pm-live" aria-live="polite"></p>
        </div>
        <button class="btn btn-terra" type="button" id="pm-go"><span>Estimer mon appartement</span> <svg aria-hidden="true"><use href="#arrow"/></svg></button>
      </div>
    </div>
  </div>
</section>

<div class="dusk-shell gutter">
  <section class="dusk" id="dusk" aria-label="Le soir">
    <div class="bgimg" id="dusk-img"><img src="/img/immeuble-soir.webp" alt="Façade haussmannienne au crépuscule, quelques fenêtres allumées" loading="lazy"></div>
    <div class="dusk-copy">
      <p class="eyebrow" style="color:rgba(255,246,234,.75)">Pendant votre absence</p>
      <h2 data-reveal>Vous êtes loin.<br><em class="it">La lumière n'est pas allumée pour rien.</em></h2>
      <p data-reveal>Vos voyageurs sont accueillis, l'appartement est entretenu entre chaque séjour, et vous recevez un relevé détaillé. Vous suivez tout, sans rien gérer.</p>
      <button class="btn btn-terra" type="button" data-open-flow data-reveal>Estimer mon appartement <svg aria-hidden="true"><use href="#arrow"/></svg></button>
    </div>
  </section>
</div>
<div class="dusk-tail"></div>

<section class="faq-sec gutter" id="questions">
  <div class="wrap faq-grid">
    <div class="faq-side">
      <p class="eyebrow">Questions</p>
      <h2>Ce que les propriétaires <span class="it">nous demandent.</span></h2>
      <div class="pimg" data-reveal-img><img src="/img/salle-a-manger.webp" alt="Salle à manger d'un appartement parisien, mur bleu et fauteuil rose" loading="lazy"></div>
      <p>Une autre question&nbsp;? Nous en parlons lors de l'estimation.</p>
    </div>
    <div class="faq">
      <details><summary>Combien coûte Haustmann&nbsp;?</summary><p>12&nbsp;% des loyers perçus, pour une gestion complète. Il n'y a pas de frais d'entrée. Le ménage est payé par le voyageur à chaque séjour.</p></details>
      <details><summary>Ai-je le droit de louer mon appartement&nbsp;?</summary><p>Si c'est votre résidence principale, vous pouvez la louer jusqu'à 90 nuits par an à Paris, avec un numéro d'enregistrement affiché sur chaque annonce. Pour une résidence secondaire, il faut une autorisation de changement d'usage. Nous vérifions votre situation avec vous avant toute mise en ligne.</p></details>
      <details><summary>Sur quelles plateformes mon appartement est-il publié&nbsp;?</summary><p>Airbnb, Booking.com et Vrbo. Les trois calendriers sont synchronisés, pour éviter les doubles réservations et tenir le compte exact des nuits.</p></details>
      <details><summary>Les photos sont-elles incluses&nbsp;?</summary><p>Oui. Un photographe professionnel passe avant la mise en ligne.</p></details>
      <details><summary>Que deviennent mes affaires personnelles&nbsp;?</summary><p>Nous préparons l'appartement avec vous avant votre départ&nbsp;: ce qui doit être rangé, ce qui peut rester, et un placard fermé à clé pour vos effets personnels.</p></details>
      <details><summary>Puis-je arrêter quand je veux&nbsp;?</summary><p>Oui. Il n'y a pas d'engagement de durée. Les réservations déjà acceptées sont honorées.</p></details>
    </div>
  </div>
</section>

<div class="final-shell gutter">
  <section class="final" id="final" aria-label="Estimation">
    <div class="bgimg"><img src="/img/facades-or.webp" alt="Deux façades haussmanniennes ouvragées dans la lumière du soir" loading="lazy"></div>
    <p class="f-word" id="f-word" aria-hidden="true">HAUS<i class="it">T</i>MANN</p>
    <div class="f-bottom">
      <div class="f-copy">
        <p class="eyebrow" style="color:rgba(255,246,234,.75)">Estimation gratuite</p>
        <h2>Combien rapporterait votre appartement pendant vos absences&nbsp;?</h2>
        <p>Cinq questions, deux minutes.</p>
        <button class="btn btn-terra" type="button" data-open-flow>Estimer mon appartement <svg aria-hidden="true"><use href="#arrow"/></svg></button>
      </div>
      <span class="mz"><button class="orb" type="button" data-open-flow><svg aria-hidden="true"><use href="#arrow"/></svg><span>Commencer</span></button></span>
    </div>
  </section>
</div>
