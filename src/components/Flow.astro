---
import ParisPlan from './ParisPlan.astro';
---
<div class="flow" id="flow" role="dialog" aria-modal="true" aria-labelledby="flow-title" hidden>
  <aside class="flow-aside" aria-hidden="true">
    <img src="/img/immeuble-angle.webp" alt="">
    <span class="logo">Haus<i>t</i>mann</span>
    <ol id="flow-steps"><li>Arrondissement</li><li>Logement</li><li>Pièces</li><li>Nuits</li><li>Coordonnées</li></ol>
  </aside>
  <div class="flow-main gutter">
    <div class="flow-top">
      <span class="flow-count" id="flow-count">Étape 1 sur 5</span>
      <button class="close" type="button" id="flow-close" aria-label="Fermer l'estimation"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" fill="none"/></svg></button>
      <div class="progress" aria-hidden="true"><i id="flow-progress"></i></div>
    </div>
    <div class="flow-body" id="step-host"></div>
  </div>
  <!-- Étape 1 : le plan, copié par site.js dans l'étape -->
  <template id="pm-tpl">
    <div class="pm">
      <div class="pm-clip"><ParisPlan /></div>
      <div class="pm-out">
        <p class="pm-hint">Choisissez votre arrondissement sur le plan.</p>
        <div class="pm-sel" hidden><b class="pm-n"></b><span class="pm-cp"></span><span class="pm-q"></span></div>
        <p class="sr pm-live" aria-live="polite"></p>
      </div>
    </div>
  </template>
</div>
